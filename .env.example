# ── App / CORS ────────────────────────────────────────────────────────────────
ENVIRONMENT=development # development | production — development allows any CORS origin
# PORTAL_PORT=3000
# PORTAL_HOST=localhost   # optional — overrides auto-detected request host

# JSON array (as a string) of allowed origins. Used when ENVIRONMENT=production.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

PDF_RENDER_QUOTA_MULTIPLIER=8

# ── Auth & Security ───────────────────────────────────────────────────────────
# Random secret Chainlit uses to sign session cookies/JWTs. Generate with:
#   openssl rand -hex 32
CHAINLIT_AUTH_SECRET="secret-chainlit-auth-secret"

# Supabase project dashboard → Settings → Data API → Project URL.
SUPABASE_URL="https://project_id.supabase.co"
# Supabase dashboard → Settings → API → service_role key (NOT the anon/public key).
SUPABASE_SERVICE_ROLE_KEY="service_role_key"

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://glyphuser:glyphpass@localhost:5432/glyphscholar"
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# ── Storage / Uploads ─────────────────────────────────────────────────────────
UPLOAD_ROOT=./data/uploads
MAX_USER_UPLOAD_BYTES=209715200 # 200 MB per user
SESSION_CLEANUP_OLDER_THAN_DAYS=30

# ── Ingestion ─────────────────────────────────────────────────────────────────
RENDER_CONCURRENCY=1
CHUNK_SIZE=256
CHUNK_OVERLAP=32
MAX_PDF_PAGES=150

# ── MinerU (PDF parsing) ──────────────────────────────────────────────────────
# API token from your MinerU account: https://mineru.net → API Keys.
MINERU_TOKEN="secret-mineru-token"
MINERU_BASE_URL="https://mineru.net/api/v4"
# vlm = vision-language parsing model; check MinerU's docs for other supported
# model_version values if you need a different parsing pipeline.
MINERU_MODEL_VERSION=vlm
MINERU_IS_OCR=false
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_LANGUAGE=en
# How often (seconds) to poll MinerU for parse-job completion, and the max
# total time to wait before giving up.
MINERU_POLL_INTERVAL=10
MINERU_MAX_POLL_TIME=1800

# Optional overrides — all have code defaults.
# MINERU_OUTPUT_DIR=./data/mineru_output
# MINERU_FILENAME_MAX_LENGTH=200
# MINERU_EXTRACT_AND_DELETE_ZIP=true
# MINERU_PAGE_RANGE=
# MINERU_MAX_RETRIES=3
# MINERU_BACKOFF_FACTOR=2.0
# MINERU_SUBMIT_TIMEOUT=30
# MINERU_POLL_TIMEOUT=30
# MINERU_UPLOAD_TIMEOUT=60
# MINERU_DOWNLOAD_TIMEOUT=120
# MINERU_HEAD_TIMEOUT=15

# ── Model selection ───────────────────────────────────────────────────────────
USE_MODAL_EMBED=False
USE_MODAL_RERANK=False
USE_MODAL_ANSWER=False

EMBED_MODEL="Qwen/Qwen3-VL-Embedding-2B"
RERANK_MODEL="Qwen/Qwen3-VL-Reranker-2B"
ANSWER_MODEL="Qwen/Qwen3-VL-2B-Instruct"
EMBED_DIM=2048

# ── Modal: deployment secrets ─────────────────────────────────────────────────
# These two must match the values stored in the `glyphscholar-secret` Modal
# Secret (see modal/services.py) — the deployed EmbeddingServer,
# RerankServer, and AnswerServer all check MODAL_API_KEY against it, and
# HF_TOKEN raises Hugging Face's model-download rate limits.
#
# 1. Generate MODAL_API_KEY:
#      openssl rand -hex 32
# 2. Get HF_TOKEN from https://huggingface.co/settings/tokens (a "Read" token
#    is enough — it's only used for downloading public model weights).
# 3. Push both into the same Modal Secret (create it if it doesn't exist yet,
#    or --force to update it):
#      modal secret create --force glyphscholar-secret \
#        MODAL_API_KEY="<value below>" HF_TOKEN="<value below>"
#   or
#     modal secret create --force glyphscholar-secret \
#        MODAL_API_KEY="$(grep -m1 '^MODAL_API_KEY=' .env | cut -d= -f2-)" \
#        HF_TOKEN="$(grep -m1 '^HF_TOKEN=' .env | cut -d= -f2-)"
MODAL_API_KEY="<generate with: openssl rand -hex 32>"
HF_TOKEN="<hugging face access token>"

MODAL_EMBED_GPU=A10G
MODAL_RERANK_GPU=A10G
MODAL_ANSWER_GPU=A10G

# ── Modal: reranker ────────────────────────────────────────────────────────────
RERANK_TOP_N=3

# Query-time raster fallback sensitivity thresholds (optional explicit definitions)
TEXT_FALLBACK_DISTANCE=0.35
PIXEL_FALLBACK_DISTANCE=0.35

# ── Modal: answering — context limits & retrieval top-k ───────────────────────
MODAL_MAX_CONTEXT_TOKENS=16000
MODAL_MAX_RESPONSE_TOKENS=2048
MODAL_FINAL_TOP_K=5
MODAL_DENSE_TOP_K=15
MODAL_PIXEL_TOP_K=2

# ── Ollama (local fallback) ────────────────────────────────────────────────────
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_ANSWER_MODEL="qwen3-vl:2b-instruct" # must be pulled: ollama pull qwen3-vl:2b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text # must be pulled: ollama pull nomic-embed-text

OLLAMA_MAX_CONTEXT_TOKENS=6144
OLLAMA_MAX_RESPONSE_TOKENS=768
OLLAMA_NUM_CTX=6144
OLLAMA_FINAL_TOP_K=3
OLLAMA_DENSE_TOP_K=10
OLLAMA_PIXEL_TOP_K=2

# ── Opik ─────────────────────────────────────────────────────────────────────────
OPIK_API_KEY="<opik-api-key>"
OPIK_WORKSPACE="glyphscholar"
OPIK_PROJECT_NAME="GlyphScholar"
